# ============================================================
# Renko ATR Pro Cloud Cockpit — Environment Variables
# Copy to .env locally OR set in Railway / Render / Fly.io UI
# ============================================================

# 1. Dashboard Web Security (Strongly Recommended for Internet Hosting!)
# When set, anyone visiting your URL must enter this password to unlock the dashboard.
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# 2. Capital.com API Credentials (Settings -> API Integrations -> Generate API Key)
CAPITAL_ENV=demo
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# 3. 24/7 Cloud Watcher Auto-Start on Container Boot
AUTO_START_WATCHER=false

# 4. Optional Telegram Instant Mobile Alerts (when a Semi-Auto Ticket triggers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
